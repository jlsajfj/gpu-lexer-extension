{
  "manifest_version": 3,
  "name": "GPU Lexer Syntax Highlighting",
  "version": "0.1.0",
  "description": "Syntax-highlights <pre> and <code> blocks with gpu-lexer, a small WebGPU model. Blocks the page already highlighted are left alone.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "offscreen", "storage"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["highlight.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
