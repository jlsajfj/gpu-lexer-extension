{
  "name": "gpu-lexer-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that syntax-highlights <pre>/<code> blocks with gpu-lexer on WebGPU, skipping blocks the page already highlights",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "gpu-lexer": "0.0.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
